# Copy this file to .env and fill in your own values.
# .env is gitignored, so real addresses and keys stay out of the repo.

# React Native networking
EXPO_PUBLIC_USE_RN_FETCH=true

# Backend and AI service URLs.
# Use the LAN IPv4 address of the machine running the services,
# for example http://YOUR_LAN_IP:5000/api
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LAN_IP:5000/api
EXPO_PUBLIC_AI_BASE_URL=http://YOUR_LAN_IP:8000